# Copie para .env (que nunca vai para o git) e preencha.
# Tudo aqui vale só para os comandos rodados com scripts/conta-demo.sh.

# ID de 12 dígitos da conta de demo. O Terraform se recusa a rodar em qualquer outra.
TF_VAR_conta_demo=

# Token do admin do jogo (Largada e Zerar). Gere com: openssl rand -hex 24
TF_VAR_admin_token=

# E-mail do alerta de orçamento. Vazio: o alerta não é criado.
TF_VAR_email_alerta=

# Credenciais da conta de demo. Escolha UMA das duas formas:

# Forma 1: chaves direto aqui. AWS_SESSION_TOKEN só existe em credenciais temporárias.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Forma 2: um perfil nomeado (por exemplo, de "aws configure sso --profile demo").
# Apague as três linhas acima e descomente a linha abaixo. "default" é recusado.
# AWS_PROFILE=demo
